{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-empty": "warn",
    "no-undef": "error"
  },
  "globals": {
    "marked": "readonly",
    "hljs": "readonly",
    "chrome": "readonly",
    "Readability": "readonly",
    "TurndownService": "readonly",
    "DOMPurify": "readonly"
  },
  "ignorePatterns": [
    "artifacts/",
    "libs/",
    "marked.min.js",
    "node_modules/",
    "dist/",
    "dist-dev/",
    "dist-eval/",
    "plans/"
  ]
}
