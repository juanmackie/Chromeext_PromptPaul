            key={contributor.id}
            rel="noopener noreferrer"
            target="_blank"
            title={`${contributor.login} (${contributor.contributions} contributions)`}
          >
            <Image
              alt={`${contributor.login} avatar`}
              className="size-full"
              height={48}
              src={contributor.avatar_url}
              width={48}
            />
          </Link>
        ))}
      </div>
    </div>
  );
});
