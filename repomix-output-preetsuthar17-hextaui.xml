}

code[data-line-numbers="true"] .line {
  counter-increment: line-number;
  position: relative;
  padding-left: 3rem;
  line-height: 2;
}

code[data-line-numbers="true"] .line::before {
  content: counter(line-number);
  position: absolute;
  left: 0;
