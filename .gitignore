# Ignore node_modules directory
node_modules/

# Ignore Mac system files
.DS_Store

# Ignore log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore Claude AI
.claude/
.pi-subagents/

# Ignore local vibe-coding rule copies
vibe-coding-rules*.md

# Ignore local plan documents
PLAN.md
plan.md
plans/

# Ignore local agent state and release archives
.pi/
.commandcode/
Prompt-Paul-*.zip
Prompt-Paul-*.zip.sha256

# Ignore local editor settings
.vscode/

# Ignore opencode config
~/.config/opencode/

# Ignore backup and temporary files
*.bak
*.tmp
*.log

# Ignore build output
dist/
dist-dev/
dist-eval/
.baseline/

# Ignore runtime assets generated into libs/ by scripts/runtime-dependencies.js
libs/*
!libs/AGENTS.md
!libs/vendor-manifest.json
!libs/dom-accessibility-api.js
!libs/dom-accessibility-api.LICENSE.md
!libs/material-symbols-outlined.woff2

# Ignore IDE project files
.idea/
*.swp
*.swo

# Ignore coverage output
coverage/
.nyc_output/

# Ignore Playwright artifacts
test-results/
artifacts/

# Ignore dream-RSI
.dream-rsi*