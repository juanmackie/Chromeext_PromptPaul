{
  "manifest_version": 3,
  "name": "Prompt Paul- AI Insights at the click of a mouse",
  "version": "4.10",
  "description": "A Chrome extension for processing selected text using an LLM endpoint",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*.pdf", "file://*/*.pdf"],
      "js": ["pdf_content_script.js"],
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content_script_explain.js"],
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content_script_tab_summary.js"],
      "all_frames": false
    }
  ]
}
