{
  "name": "prompt-paul",
  "version": "6.4.0",
  "description": "Prompt Paul - Chrome extension for AI-powered text processing with context menus and side panel chat interface",
  "main": "background.js",
  "author": "Juan Mackie",
  "repository": {
    "type": "git",
    "url": "https://github.com/juanmackie/Chromeext_PromptPaul"
  },
  "scripts": {
    "smoke": "node scripts/smoke-check.js",
    "verify:licenses": "node scripts/verify-vendored-licenses.js",
    "audit": "npm audit --audit-level=high --omit=optional",
    "check": "npm run smoke",
    "lint": "eslint . --ext .js",
    "test": "node scripts/test-runner.js",
    "test:unit": "node scripts/test-runner.js --unit",
    "test:integration": "node scripts/test-runner.js --integration",
    "test:behavior": "vitest run",
    "test:browser": "node scripts/test-browser.js",
    "test:browser:prod": "node scripts/test-browser.js --prod",
    "build": "node scripts/build.js",
    "build:dev": "node scripts/build.js --dev",
    "build:eval": "node scripts/build.js --eval",
    "build:prod": "node scripts/build.js --prod",
    "release:prepare": "python3 scripts/update-release-metadata.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run format:check && npm run test && npm run test:behavior && npm run smoke && npm run verify:licenses",
    "ci": "npm run validate && npm run audit && npm run test:browser:prod",
    "stage:browser-harness": "node scripts/stage-browser-harness.js",
    "benchmark:act": "node scripts/act-benchmark.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^8.57.1",
    "prettier": "^3.8.3",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "chrome-extension",
    "ai",
    "llm",
    "chatgpt",
    "mistral",
    "productivity"
  ],
  "license": "MIT",
  "dependencies": {
    "@highlightjs/cdn-assets": "11.9.0",
    "@mozilla/readability": "0.6.0",
    "bootstrap": "5.3.8",
    "dompurify": "3.4.17",
    "marked": "4.3.0",
    "pdfjs-dist": "6.5.438",
    "turndown": "7.2.0"
  }
}
