{
  "name": "chrome-helpinghand",
  "version": "1.0.0",
  "description": "Chrome extension for custom instructions",
  "main": "background.js",
  "scripts": {
    "start": "node background.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky install",
    "build:css": "postcss *.css --dir dist/",
    "build:css:watch": "postcss *.css --dir dist/ --watch",
    "build": "npm run build:css",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "marked": "^17.0.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/chrome": "^0.0.276",
    "@types/dompurify": "^3.0.5",
    "autoprefixer": "^10.4.22",
    "cross-env": "^7.0.3",
    "cssnano": "^7.1.2",
    "dompurify": "^3.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-chrome": "^0.8.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.10",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.7.4"
  },
  "lint-staged": {
    "*.{js,json,css,md}": [
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "jest --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
