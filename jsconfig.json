{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "lib": ["ES2021", "DOM"],
    "types": ["chrome", "node"],
    "baseUrl": ".",
    "paths": {
      "background/*": ["./background/*"],
      "chat/*": ["./chat/*"],
      "services/*": ["./services/*"],
      "utils/*": ["./utils/*"],
      "options/*": ["./options/*"]
    }
  },
  "include": ["**/*.js", "!node_modules/**", "!tests/**", "!coverage/**", "!dist/**", "!build/**"],
  "exclude": ["node_modules", "tests", "coverage", "dist", "build"]
}
